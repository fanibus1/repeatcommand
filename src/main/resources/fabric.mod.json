{
  "schemaVersion": 1,
  "id": "repeatcommand",
  "version": "${version}",
  "name": "repeatcommand",
  "description": "Adds `/repc <command>`, which prepends `/<command>` to the chat every time it is opened with the \"Open Chat\" hotkey, until `/repc reset` or a new prefix is set.",
  "authors": ["fanibus"],
  "contact": {
    "homepage": "https://cdn.discordapp.com/emojis/1553656920353804388.webp",
    "sources": "https://cdn.discordapp.com/emojis/1553656920353804388.webp"
  },
  "license": "CC0-1.0",
  "icon": "assets/repeatcommand/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": ["name.modid.client.RepeatCommandClient"]
  },
  "mixins": [
    {
      "config": "repeatcommand.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
